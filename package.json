{
  "name": "rst-lim",
  "displayName": "rst-lim",
  "description": "rst-lim = reStructuredText, Less is More!",
  "version": "1.0.5",
  "publisher": "CeresNorthPole",
  "icon": "res/rst-lim-icon.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "url": "https://github.com/noisnemid/vscode-extension-rst-lim.git"
  },
  "activationEvents": [
    "workspaceContains:**/*.rst",
    "onLanguage:restructuredtext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "restructuredtext",
        "aliases": [
          "reStructuredText",
          "restructuredtext",
          "ReStructured Text",
          "reStructured Text",
          "RST",
          "ReST",
          "reST"
        ],
        "extensions": [
          ".rst",
          ".rest"
        ],
        "configuration": "./syntaxes/rst-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "restructuredtext",
        "scopeName": "text.restructuredtext",
        "path": "./syntaxes/rst.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
